#!/bin/awk -f
#This script takes in two input files:
# 1) the output of `bcftools head -n 1` on a simulated VCF generated by msprime
#    (or wrappers like mrpast simulate+sim2vcf)
# 2) the output of `bcftools query -f '%CHROM\t%POS\t%REF\n'` on the same VCF
# and generates a simple FASTA of ancestral allele states that can be used with
# tsinferdate_cli.py.
#The length of the contig/chromosome is taken from `bcftools head -n 1`,
# assuming that the VCF only contains records from one chromosome/contig.
#There is one simplifying assumption here:
# 1) Any invariant positions get filled with "N"
function gap_Ns(l) {
   #Derivative of https://stackoverflow.com/a/68388226
   #There's a bit of memory waste in that a string of length ceil(lg(l))
   # is generated. One unprofiled alternative would be to actually
   # convert l into binary and build the string up by progressively
   # concatenating intermediates. Probably not worth it for small l
   # though.
   #Set the gap character:
   c="N";
   #Determine the base-2 log of the desired length:
   e=log(l)/log(2);
   m=int(e);
   #But make sure to take ceil(lg(l)):
   m+=(m < e ? 1 : 0);
   #Start the output gap string off as a length-1 string of the gap character:
   s=c;
   #Exponentially grow the string via concatenation:
   for (i=1; i<=m; i++) {
      s=s s;
   };
   #Trim the string down from length ceil(lg(l)) back to l:
   s=substr(s, 1, l);
   return s;
}
BEGIN{
   FS="\t";
   prev_pos=0;
   prev_chr="";
}
#First input file is the output of `bcftools head -n 1`
FNR==NR&&/^##contig/{
   chrom="";
   chromlen=0;
   #Parse the tag-value pairs out of the header:
   ctgstr=$1;
   sub("##contig=<", "", ctgstr);
   sub(">", "", ctgstr);
   n=split(ctgstr, ctgtags, ",");
   for (i=1; i<=n; i++) {
      split(ctgtags[i], tagval, "=");
      #Grab the contig ID and length tags:
      if (tagval[1] == "ID") {
         chrom=tagval[2];
      } else if (tagval[1] == "length") {
         chromlen=tagval[2];
      };
   };
   if (chrom == "" || chromlen == 0) {
      print "contig header line is missing ID and/or length tag. Cannot proceed." > "/dev/stderr"; exit 2;
   };
   #Store all contig/chromosome lengths from the headers (as there can be multiple):
   chromlens[chrom]=chromlen;
}
FNR==NR&&!/^#/{
   #Set chrom_len to the one contig/chromosome represented in the input simulated VCF:
   if ($1 in chromlens) {
      chrom_len=chromlens[$1];
   } else {
      print "VCF is missing contig header line for its variant records. Cannot proceed." > "/dev/stderr"; exit 3;
   };
}
#Second input file is the output of `bcftools query -f '%CHROM\t%POS\t%REF\n'`
FNR<NR{
   #Sanity check to make sure there aren't multiple contigs/chromosomes represented in the VCF:
   if ($1 != prev_chr && prev_chr != "") {
      print "Input contains variants from multiple chromosomes. Please only provide per-chromosome input. Quitting." > "/dev/stderr";
      exit 4;
   };
   if (prev_chr == "") {
      #Print the header:
      #Note: This header mimics the style of the EPO6 ancestral allele FASTAs from Ensembl.
      print ">ANCESTOR_for_chromosome:Simulated:"$1":1:"chrom_len":1";
   };
   #Print the Ns of the preceding gap plus the ancestral (REF) allele at the
   # current variant:
   gap_len=$2-prev_pos-1;
   printf "%s%s", gap_Ns(gap_len), $3;
   #Now store the current chromosome and position for use in the next round:
   prev_chr=$1;
   prev_pos=$2;
}
END{
   #Print the final gap segment:
   gap_len=chrom_len-prev_pos;
   printf "%s\n", gap_Ns(gap_len);
}
